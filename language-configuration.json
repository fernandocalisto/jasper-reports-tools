{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["<!--", "-->"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "<", "close": ">" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*<(?![/!?])([\\w:.-]+)(?:\\s[^>]*)?>.*$",
    "decreaseIndentPattern": "^\\s*</([\\w:.-]+)>\\s*$"
  }
}
