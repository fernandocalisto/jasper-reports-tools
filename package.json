        },
        {
          "command": "jasper.uploadNewJrxmlToServer",
          "when": "view == jasper-servers && viewItem == serverFolder",
          "group": "1_actions@2"
        },
        {
          "command": "jasper.updateJrxmlOnServer",
          "when": "view == jasper-servers && viewItem == serverFolder",
          "group": "1_actions@3"
        },
        {
          "command": "jasper.refreshServerTree",
          "when": "view == jasper-servers && viewItem == serverFolder",
          "group": "1_actions@3"
        },
        {
          "command": "jasper.downloadServerReport",
          "when": "view == jasper-servers && viewItem =~ /^serverReport/",
