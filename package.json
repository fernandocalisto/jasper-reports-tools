{
  "name": "jasper-reports-tools",
  "displayName": "JasperReports Developer Tools",
  "description": "Extensão profissional e leve para criação, manutenção, compilação, teste e deploy de relatórios JasperReports (.jrxml e .jasper).",
  "version": "0.1.0",
  "publisher": "jasper-tools",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:jasper-databases",
    "onCommand:jasper.addConnection",
    "onCommand:jasper.editConnection",
    "onCommand:jasper.deleteConnection",
    "onCommand:jasper.setActiveConnection",
    "onCommand:jasper.testConnection",
    "onCommand:jasper.compileCurrentReport",
    "onCommand:jasper.openPreview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jasper-tools",
          "title": "JasperReports",
          "icon": "media/icons/jasper.svg"
        }
      ]
    },
    "views": {
      "jasper-tools": [
        {
          "id": "jasper-databases",
          "name": "Conexões de Banco de Dados"
        }
      ]
    },
    "commands": [
      {
        "command": "jasper.addConnection",
        "title": "Adicionar Nova Conexão",
        "category": "Jasper",
        "icon": "$(add)"
      },
      {
        "command": "jasper.editConnection",
        "title": "Editar Conexão",
        "category": "Jasper",
        "icon": "$(edit)"
      },
      {
        "command": "jasper.deleteConnection",
        "title": "Excluir Conexão",
        "category": "Jasper",
        "icon": "$(trash)"
      },
      {
        "command": "jasper.setActiveConnection",
        "title": "Definir como Conexão Ativa",
        "category": "Jasper",
        "icon": "$(check)"
      },
      {
        "command": "jasper.testConnection",
        "title": "Testar Conexão",
        "category": "Jasper",
        "icon": "$(plug)"
      },
      {
        "command": "jasper.compileCurrentReport",
        "title": "Compilar Relatório Aberto",
        "category": "Jasper",
        "icon": "$(gear)"
      },
      {
        "command": "jasper.openPreview",
        "title": "Abrir Preview Dividido (Split)",
        "category": "Jasper",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "jasper.addConnection",
          "when": "view == jasper-databases",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "jasper.compileCurrentReport",
          "when": "resourceExtname == .jrxml",
          "group": "navigation@1"
        },
        {
          "command": "jasper.openPreview",
          "when": "resourceExtname == .jrxml",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "jasper.compileCurrentReport",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@1"
        },
        {
          "command": "jasper.openPreview",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@2"
        }
      ],
      "explorer/context": [
        {
          "command": "jasper.compileCurrentReport",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@1"
        },
        {
          "command": "jasper.openPreview",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@2"
        }
      ],
      "view/item/context": [
        {
          "command": "jasper.setActiveConnection",
          "when": "view == jasper-databases && viewItem =~ /^databaseProfile/",
          "group": "inline@1"
        },
        {
          "command": "jasper.testConnection",
          "when": "view == jasper-databases && viewItem =~ /^databaseProfile/",
          "group": "inline@2"
        },
        {
          "command": "jasper.editConnection",
          "when": "view == jasper-databases && viewItem =~ /^databaseProfile/",
          "group": "inline@3"
        },
        {
          "command": "jasper.deleteConnection",
          "when": "view == jasper-databases && viewItem =~ /^databaseProfile/",
          "group": "inline@4"
        },
        {
          "command": "jasper.setActiveConnection",
          "when": "view == jasper-databases && viewItem =~ /^databaseProfile/",
          "group": "1_actions@1"
        },
        {
          "command": "jasper.testConnection",
          "when": "view == jasper-databases && viewItem =~ /^databaseProfile/",
          "group": "1_actions@2"
        },
        {
          "command": "jasper.editConnection",
          "when": "view == jasper-databases && viewItem =~ /^databaseProfile/",
          "group": "2_modification@1"
        },
        {
          "command": "jasper.deleteConnection",
          "when": "view == jasper-databases && viewItem =~ /^databaseProfile/",
          "group": "2_modification@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "jasper.compileCurrentReport",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus && resourceExtname == .jrxml"
      },
      {
        "command": "jasper.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && resourceExtname == .jrxml"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
