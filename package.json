    "configuration": {
      "title": "JasperReports",
      "properties": {
        "jasper.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Ativa ou desativa a validação automática de parâmetros no Preview e no Field Viewer."
        },
        "jasper.validation.autoValidateOnPreviewOpen": {
          "type": "boolean",
          "default": true,
          "description": "Valida automaticamente os parâmetros do relatório ao abrir o painel de Preview."
        },
        "jasper.validation.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 50,
          "maximum": 5000,
          "description": "Tempo de debounce (em ms) para validação em tempo real ao editar parâmetros."
        },
        "jasper.validation.showWarningsAsErrors": {
          "type": "boolean",
          "default": false,
          "description": "Exibe avisos de validação (como range numérico e regex) como erros que bloqueiam a execução."
        },
        "jasper.expressionEditor.defaultLanguage": {
          "type": "string",
          "enum": [
            "groovy",
            "java"
          ],
          "default": "groovy",
          "description": "Linguagem padrão para análise e highlight no Expression Editor quando omitida no .jrxml."
        },
        "jasper.expressionEditor.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Exibe CodeLens 'Editar Expressão' e resumo de preview acima de tags de expressão no XML (.jrxml)."
        },
        "jasper.expressionEditor.enableInlineValidation": {
          "type": "boolean",
          "default": true,
          "description": "Valida expressões JasperReports em tempo real no editor XML destacando referências quebradas e erros de sintaxe."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  }
}
