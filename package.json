        },
        {
          "command": "jasper.deleteConnection",
          "when": "view == jasper-databases && viewItem =~ /^databaseProfile/",
          "group": "2_modification@2"
        },
        {
          "command": "jasper.setActiveServer",
          "when": "view == jasper-servers && viewItem =~ /^serverProfile/",
          "group": "inline@1"
        },
        {
          "command": "jasper.editServer",
          "when": "view == jasper-servers && viewItem =~ /^serverProfile/",
          "group": "inline@2"
        },
        {
          "command": "jasper.deleteServer",
          "when": "view == jasper-servers && viewItem =~ /^serverProfile/",
          "group": "inline@3"
        },
        {
          "command": "jasper.setActiveServer",
          "when": "view == jasper-servers && viewItem =~ /^serverProfile/",
          "group": "1_actions@1"
        },
        {
          "command": "jasper.refreshServerTree",
          "when": "view == jasper-servers && viewItem =~ /^serverProfile/",
          "group": "1_actions@2"
        },
        {
          "command": "jasper.editServer",
          "when": "view == jasper-servers && viewItem =~ /^serverProfile/",
