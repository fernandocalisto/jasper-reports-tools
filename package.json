    "keybindings": [
      {
        "command": "jasper.compileCurrentReport",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus && resourceExtname == .jrxml"
      },
      {
        "command": "jasper.decompileJasper",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "resourceExtname == .jasper"
      },
      {
        "command": "jasper.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && resourceExtname == .jrxml"
      },
      {
        "command": "jasper.openFieldViewer",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorTextFocus && resourceExtname == .jrxml"
      },
      {
        "command": "jasper.openExpressionEditor",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorTextFocus && resourceExtname == .jrxml"
      },
      {
        "command": "jasper.batchCompile",
        "key": "ctrl+shift+alt+b",
        "mac": "cmd+shift+alt+b",
        "when": "explorerViewletFocus"
      },
      {
        "command": "jasper.batchExport",
        "key": "ctrl+shift+alt+e",
        "mac": "cmd+shift+alt+e",
        "when": "explorerViewletFocus"
      },
      {
        "command": "jasper.compareReports",
        "key": "ctrl+shift+alt+c",
        "mac": "cmd+shift+alt+c",
        "when": "explorerViewletFocus"
      },
      {
        "command": "jasper.searchServerResources",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "view == jasper-servers"
      },
      {
        "command": "jasper.copyServerResource",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "view == jasper-servers && viewItem =~ /^serverReport/"
      },
      {
        "command": "jasper.copyServerResource",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "view == jasper-servers && viewItem == serverFolder"
      },
      {
        "command": "jasper.pasteServerResource",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "explorerViewletFocus"
      },
      {
        "command": "jasper.copyServerResourcePath",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "view == jasper-servers"
      },
      {
        "command": "jasper.refreshServerTree",
        "key": "f5",
        "when": "view == jasper-servers"
      },
      {
        "command": "jasper.clearServerSearch",
        "key": "escape",
        "when": "view == jasper-servers && jasper.searchActive"
      },
      {
        "command": "jasper.navigateServerUp",
        "key": "backspace",
        "when": "view == jasper-servers && listFocus && !inputFocus"
      },
      {
        "command": "jasper.downloadServerReport",
        "key": "enter",
        "when": "view == jasper-servers && listFocus && viewItem =~ /^serverReport/"
      },
      {
        "command": "jasper.openScheduler",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s"
      },
      {
        "command": "jasper.refreshSchedules",
        "key": "f5",
        "when": "view == jasper-schedules"
      },
      {
        "command": "jasper.createScheduleJob",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "view == jasper-schedules"
      },
      {
        "command": "jasper.runJobNow",
        "key": "enter",
        "when": "view == jasper-schedules && viewItem =~ /^scheduleJob/"
      },
      {
        "command": "jasper.deleteScheduleJob",
