{
  "name": "jasper-reports-tools",
  "displayName": "JasperReports Developer Tools",
  "description": "Extensão profissional e leve para criação, manutenção, compilação, teste e deploy de relatórios JasperReports (.jrxml e .jasper).",
  "version": "0.1.0",
  "publisher": "fernandocalisto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fernandocalisto/jasper-reports-tools.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "jasperreports",
    "jrxml",
    "jasper",
    "jasperserver",
    "jaspersoft",
    "reports",
    "sql"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:xml",
    "onView:jasper-databases",
    "onView:jasper-servers",
    "onView:jasper-schedules",
    "onCommand:jasper.addConnection",
    "onCommand:jasper.editConnection",
    "onCommand:jasper.deleteConnection",
    "onCommand:jasper.setActiveConnection",
    "onCommand:jasper.testConnection",
    "onCommand:jasper.compileCurrentReport",
    "onCommand:jasper.decompileJasper",
    "onCommand:jasper.openPreview",
    "onCommand:jasper.openFieldViewer",
    "onCommand:jasper.batchCompile",
    "onCommand:jasper.batchExport",
    "onCommand:jasper.addServer",
    "onCommand:jasper.editServer",
    "onCommand:jasper.deleteServer",
    "onCommand:jasper.setActiveServer",
    "onCommand:jasper.refreshServerTree",
    "onCommand:jasper.downloadServerReport",
    "onCommand:jasper.deployJasperToServer",
    "onCommand:jasper.updateJrxmlOnServer",
    "onCommand:jasper.deleteServerResource",
    "onCommand:jasper.uploadNewJrxmlToServer",
    "onCommand:jasper.searchServerResources",
    "onCommand:jasper.clearServerSearch",
    "onCommand:jasper.copyServerResource",
    "onCommand:jasper.pasteServerResource",
    "onCommand:jasper.copyServerResourcePath",
    "onCommand:jasper.toggleServerSelectionMode",
    "onCommand:jasper.downloadSelectedServerResources",
    "onCommand:jasper.navigateServerBreadcrumb",
    "onCommand:jasper.navigateServerUp",
    "onCommand:jasper.compareReports",
    "onCommand:jasper.compareWithServer",
    "onCommand:jasper.openDiffViewer",
    "onCommand:jasper.openScheduler",
    "onCommand:jasper.refreshSchedules",
    "onCommand:jasper.createScheduleJob",
    "onCommand:jasper.editScheduleJob",
    "onCommand:jasper.editTrigger",
    "onCommand:jasper.runJobNow",
    "onCommand:jasper.deleteScheduleJob",
    "onCommand:jasper.pauseAllJobTriggers",
    "onCommand:jasper.pauseTrigger",
    "onCommand:jasper.resumeTrigger",
    "onCommand:jasper.deleteTrigger",
    "onCommand:jasper.viewJobExecutions",
    "onCommand:jasper.downloadExecutionOutput",
    "onCommand:jasper.cancelExecution",
    "onCommand:jasper.searchSchedules",
    "onCommand:jasper.copyScheduleJob",
    "onCommand:jasper.pasteScheduleJob",
    "onCommand:jasper.openExpressionEditor",
    "onCustomEditor:jasperExpressionEditor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "xml",
        "extensions": [
          ".jrxml"
        ],
        "aliases": [
          "JRXML",
          "JasperReports XML"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/icons/file-jrxml.svg",
          "dark": "./media/icons/file-jrxml.svg"
        }
      },
      {
        "id": "jasper-binary",
        "extensions": [
          ".jasper"
        ],
        "aliases": [
          "Jasper Compiled Report"
        ],
        "icon": {
          "light": "./media/icons/file-jasper.svg",
          "dark": "./media/icons/file-jasper.svg"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "jasperExpressionEditor",
        "displayName": "Jasper Expression Editor",
        "selector": [
          {
            "filenamePattern": "*.jrexpr"
          }
        ],
        "priority": "default"
      }
    ],
    "snippets": [
      {
        "language": "xml",
        "path": "./snippets/jasper-snippets.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.jrxml",
        "url": "./schemas/jasperreport.xsd"
      }
    ],
    "xmlValidation": [
      {
        "fileMatch": "*.jrxml",
        "url": "./schemas/jasperreport.xsd"
      }
    ],
    "iconThemes": [
      {
        "id": "jasper-file-icons",
        "label": "JasperReports Icons",
        "path": "./media/icons/jasper-icon-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jasper-tools",
          "title": "JasperReports",
          "icon": "media/icons/jasper.svg"
        }
      ]
    },
    "views": {
      "jasper-tools": [
        {
          "id": "jasper-databases",
          "name": "Conexões de Banco de Dados"
        },
        {
          "id": "jasper-servers",
          "name": "JasperServer Explorer"
        },
        {
          "id": "jasper-schedules",
          "name": "Agendamentos",
          "when": "jasperServerConnected"
        }
      ]
    },
    "commands": [
      {
        "command": "jasper.addConnection",
        "title": "Adicionar Nova Conexão",
        "category": "Jasper",
        "icon": "$(add)"
      },
      {
        "command": "jasper.editConnection",
        "title": "Editar Conexão",
        "category": "Jasper",
        "icon": "$(edit)"
      },
      {
        "command": "jasper.deleteConnection",
        "title": "Excluir Conexão",
        "category": "Jasper",
        "icon": "$(trash)"
      },
      {
        "command": "jasper.setActiveConnection",
        "title": "Definir como Conexão Ativa",
        "category": "Jasper",
        "icon": "$(check)"
      },
      {
        "command": "jasper.testConnection",
        "title": "Testar Conexão",
        "category": "Jasper",
        "icon": "$(plug)"
      },
      {
        "command": "jasper.compileCurrentReport",
        "title": "Compilar Relatório Aberto",
        "category": "Jasper",
        "icon": "$(gear)"
      },
      {
        "command": "jasper.decompileJasper",
        "title": "Descompilar .jasper para .jrxml",
        "category": "Jasper",
        "icon": "$(arrow-down)"
      },
      {
        "command": "jasper.openPreview",
        "title": "Abrir Preview Dividido (Split)",
        "category": "Jasper",
        "icon": "$(open-preview)"
      },
      {
        "command": "jasper.openFieldViewer",
        "title": "Visualizar Campos da Query (Field Viewer)",
        "category": "Jasper",
        "icon": "$(table)"
      },
      {
        "command": "jasper.openExpressionEditor",
        "title": "Editar Expressão (Expression Editor)",
        "category": "Jasper",
        "icon": "$(edit)"
      },
      {
        "command": "jasper.batchCompile",
        "title": "Compilar em Lote",
        "category": "Jasper",
        "icon": "$(gear)"
      },
      {
        "command": "jasper.batchExport",
        "title": "Exportar em Lote (PDF/Jasper)",
        "category": "Jasper",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "jasper.addServer",
        "title": "Adicionar Servidor JasperServer",
        "category": "Jasper",
        "icon": "$(add)"
      },
      {
        "command": "jasper.editServer",
        "title": "Editar Servidor JasperServer",
        "category": "Jasper",
        "icon": "$(edit)"
      },
      {
        "command": "jasper.deleteServer",
        "title": "Excluir Servidor JasperServer",
        "category": "Jasper",
        "icon": "$(trash)"
      },
      {
        "command": "jasper.setActiveServer",
        "title": "Definir como Servidor Ativo",
        "category": "Jasper",
        "icon": "$(check)"
      },
      {
        "command": "jasper.refreshServerTree",
        "title": "Atualizar Repositório JasperServer",
        "category": "Jasper",
        "icon": "$(refresh)"
      },
      {
        "command": "jasper.downloadServerReport",
        "title": "Baixar e Abrir",
        "category": "Jasper",
        "icon": "$(cloud-download)"
      },
      {
        "command": "jasper.deployJasperToServer",
        "title": "Deploy .jasper (Compilar e Enviar)",
        "category": "Jasper",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "jasper.updateJrxmlOnServer",
        "title": "Atualizar .jrxml no Servidor",
        "category": "Jasper",
        "icon": "$(sync)"
      },
      {
        "command": "jasper.deleteServerResource",
        "title": "Excluir no Servidor",
        "category": "Jasper",
        "icon": "$(trash)"
      },
      {
        "command": "jasper.uploadNewJrxmlToServer",
        "title": "Enviar Novo .jrxml para o Servidor",
        "category": "Jasper",
        "icon": "$(new-file)"
      },
      {
        "command": "jasper.searchServerResources",
        "title": "Buscar no JasperServer",
        "category": "Jasper",
        "icon": "$(search)"
      },
      {
        "command": "jasper.clearServerSearch",
        "title": "Limpar Busca no JasperServer",
        "category": "Jasper",
        "icon": "$(close)"
      },
      {
        "command": "jasper.copyServerResource",
        "title": "Copiar Recurso",
        "category": "Jasper",
        "icon": "$(copy)"
      },
      {
        "command": "jasper.pasteServerResource",
        "title": "Colar Recurso do Servidor",
        "category": "Jasper",
        "icon": "$(clippy)"
      },
      {
        "command": "jasper.copyServerResourcePath",
        "title": "Copiar Caminho no Servidor",
        "category": "Jasper",
        "icon": "$(link)"
      },
      {
        "command": "jasper.toggleServerSelectionMode",
        "title": "Alternar Modo Seleção",
        "category": "Jasper",
        "icon": "$(check-all)"
      },
      {
        "command": "jasper.downloadSelectedServerResources",
        "title": "Baixar Selecionados",
        "category": "Jasper",
        "icon": "$(cloud-download)"
      },
      {
        "command": "jasper.navigateServerBreadcrumb",
        "title": "Navegar pelo Breadcrumb",
        "category": "Jasper",
        "icon": "$(list-tree)"
      },
      {
        "command": "jasper.navigateServerUp",
        "title": "Subir um Nível no Repositório",
        "category": "Jasper",
        "icon": "$(arrow-up)"
      },
      {
        "command": "jasper.compareReports",
        "title": "Comparar Relatórios",
        "category": "Jasper",
        "icon": "$(diff)"
      },
      {
        "command": "jasper.compareWithServer",
        "title": "Comparar com Servidor",
        "category": "Jasper",
        "icon": "$(diff)"
      },
      {
        "command": "jasper.openDiffViewer",
        "title": "Abrir Visualizador de Diff",
        "category": "Jasper",
        "icon": "$(diff)"
      },
      {
        "command": "jasper.openScheduler",
        "title": "Abrir Agendamentos",
        "category": "Jasper",
        "icon": "$(clock)"
      },
      {
        "command": "jasper.refreshSchedules",
        "title": "Atualizar Agendamentos",
        "category": "Jasper",
        "icon": "$(refresh)"
      },
      {
        "command": "jasper.createScheduleJob",
        "title": "Criar Agendamento",
        "category": "Jasper",
        "icon": "$(add)"
      },
      {
        "command": "jasper.editScheduleJob",
        "title": "Editar Agendamento",
        "category": "Jasper",
        "icon": "$(edit)"
      },
      {
        "command": "jasper.editTrigger",
        "title": "Editar Trigger",
        "category": "Jasper",
        "icon": "$(edit)"
      },
      {
        "command": "jasper.runJobNow",
        "title": "Executar Agora",
        "category": "Jasper",
        "icon": "$(play)"
      },
      {
        "command": "jasper.deleteScheduleJob",
        "title": "Deletar Agendamento",
        "category": "Jasper",
        "icon": "$(trash)"
      },
      {
        "command": "jasper.pauseAllJobTriggers",
        "title": "Pausar Todos Triggers",
        "category": "Jasper",
        "icon": "$(debug-pause)"
      },
      {
        "command": "jasper.pauseTrigger",
        "title": "Pausar Trigger",
        "category": "Jasper",
        "icon": "$(debug-pause)"
      },
      {
        "command": "jasper.resumeTrigger",
        "title": "Retomar Trigger",
        "category": "Jasper",
        "icon": "$(debug-continue)"
      },
      {
        "command": "jasper.deleteTrigger",
        "title": "Deletar Trigger",
        "category": "Jasper",
        "icon": "$(trash)"
      },
      {
        "command": "jasper.viewJobExecutions",
        "title": "Ver Execuções",
        "category": "Jasper",
        "icon": "$(history)"
      },
      {
        "command": "jasper.downloadExecutionOutput",
        "title": "Baixar Output",
        "category": "Jasper",
        "icon": "$(cloud-download)"
      },
      {
        "command": "jasper.cancelExecution",
        "title": "Cancelar Execução",
        "category": "Jasper",
        "icon": "$(stop-circle)"
      },
      {
        "command": "jasper.searchSchedules",
        "title": "Buscar Agendamentos",
        "category": "Jasper",
        "icon": "$(search)"
      },
      {
        "command": "jasper.copyScheduleJob",
        "title": "Copiar Agendamento",
        "category": "Jasper",
        "icon": "$(copy)"
      },
      {
        "command": "jasper.pasteScheduleJob",
        "title": "Colar Agendamento (Duplicar)",
        "category": "Jasper",
        "icon": "$(clippy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "jasper.addConnection",
          "when": "view == jasper-databases",
          "group": "navigation"
        },
        {
          "command": "jasper.batchCompile",
          "when": "view == jasper-databases",
          "group": "navigation@8"
        },
        {
          "command": "jasper.batchExport",
          "when": "view == jasper-databases",
          "group": "navigation@8"
        },
        {
          "command": "jasper.searchServerResources",
          "when": "view == jasper-servers",
          "group": "navigation@1"
        },
        {
          "command": "jasper.clearServerSearch",
          "when": "view == jasper-servers && jasper.searchActive",
          "group": "navigation@2"
        },
        {
          "command": "jasper.navigateServerBreadcrumb",
          "when": "view == jasper-servers",
          "group": "navigation@3"
        },
        {
          "command": "jasper.toggleServerSelectionMode",
          "when": "view == jasper-servers",
          "group": "navigation@4"
        },
        {
          "command": "jasper.downloadSelectedServerResources",
          "when": "view == jasper-servers && selectionCount > 0",
          "group": "navigation@5"
        },
        {
          "command": "jasper.refreshServerTree",
          "when": "view == jasper-servers",
          "group": "navigation@6"
        },
        {
          "command": "jasper.addServer",
          "when": "view == jasper-servers",
          "group": "navigation@7"
        },
        {
          "command": "jasper.createScheduleJob",
          "when": "view == jasper-schedules",
          "group": "navigation@1"
        },
        {
          "command": "jasper.searchSchedules",
          "when": "view == jasper-schedules",
          "group": "navigation@2"
        },
        {
          "command": "jasper.refreshSchedules",
          "when": "view == jasper-schedules",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "jasper.compileCurrentReport",
          "when": "resourceExtname == .jrxml",
          "group": "navigation@1"
        },
        {
          "command": "jasper.decompileJasper",
          "when": "resourceExtname == .jasper",
          "group": "navigation@1"
        },
        {
          "command": "jasper.openPreview",
          "when": "resourceExtname == .jrxml",
          "group": "navigation@2"
        },
        {
          "command": "jasper.openFieldViewer",
          "when": "resourceExtname == .jrxml",
          "group": "navigation@3"
        },
        {
          "command": "jasper.openExpressionEditor",
          "when": "resourceExtname == .jrxml",
          "group": "navigation@4"
        },
        {
          "command": "jasper.compareReports",
          "when": "resourceExtname == .jrxml || resourceExtname == .jasper",
          "group": "1_jasper@8"
        }
      ],
      "editor/context": [
        {
          "command": "jasper.compileCurrentReport",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@1"
        },
        {
          "command": "jasper.decompileJasper",
          "when": "resourceExtname == .jasper",
          "group": "1_jasper@1"
        },
        {
          "command": "jasper.openPreview",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@2"
        },
        {
          "command": "jasper.openFieldViewer",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@3"
        },
        {
          "command": "jasper.openExpressionEditor",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@3_expr"
        },
        {
          "command": "jasper.deployJasperToServer",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@4"
        },
        {
          "command": "jasper.updateJrxmlOnServer",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@5"
        },
        {
          "command": "jasper.pasteServerResource",
          "group": "1_jasper@6"
        },
        {
          "command": "jasper.compareReports",
          "when": "resourceExtname == .jrxml || resourceExtname == .jasper",
          "group": "1_jasper@7"
        },
        {
          "command": "jasper.compareWithServer",
          "when": "resourceExtname == .jrxml || resourceExtname == .jasper",
          "group": "1_jasper@7"
        }
      ],
      "explorer/context": [
        {
          "command": "jasper.compileCurrentReport",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@1"
        },
        {
          "command": "jasper.decompileJasper",
          "when": "resourceExtname == .jasper",
          "group": "1_jasper@1"
        },
        {
          "command": "jasper.openPreview",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@2"
        },
        {
          "command": "jasper.openFieldViewer",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@3"
        },
        {
          "command": "jasper.deployJasperToServer",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@4"
        },
        {
          "command": "jasper.updateJrxmlOnServer",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@5"
        },
        {
          "command": "jasper.batchCompile",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@6"
        },
        {
          "command": "jasper.batchExport",
          "when": "resourceExtname == .jrxml",
          "group": "1_jasper@6"
        },
        {
          "command": "jasper.batchCompile",
          "when": "explorerResourceIsFolder || viewItem == folder",
          "group": "1_jasper@6"
        },
        {
          "command": "jasper.batchExport",
          "when": "explorerResourceIsFolder || viewItem == folder",
          "group": "1_jasper@6"
        },
        {
          "command": "jasper.compareReports",
          "when": "resourceExtname == .jrxml || resourceExtname == .jasper",
          "group": "1_jasper@7"
        },
        {
          "command": "jasper.compareWithServer",
          "when": "resourceExtname == .jrxml || resourceExtname == .jasper",
          "group": "1_jasper@7"
        },
        {
          "command": "jasper.pasteServerResource",
          "group": "1_jasper@8"
        }
      ],
      "view/item/context": [
        {
          "command": "jasper.setActiveConnection",
